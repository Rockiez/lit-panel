{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Rockiez/lit-panel/schema/quote-repair-patch.schema.json",
  "title": "lit-panel quote-only repair patch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "seat", "reader_id", "criteria"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "seat": { "type": "string", "pattern": "^lit-[a-z0-9-]+$" },
    "reader_id": { "type": ["string", "null"], "pattern": "^reader-[0-9]{2,}$" },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "quotes"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z]+[0-9]+$" },
          "quotes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["text", "target", "location"],
              "properties": {
                "text": { "type": "string", "minLength": 1 },
                "target": { "enum": ["text", "source"] },
                "location": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
